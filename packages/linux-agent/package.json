{
	"name": "@earendil-works/forge-linux-agent",
	"version": "0.84.3",
	"description": "Forge Linux Agent Runtime — Task scheduler, execution pipeline, and autonomous operations",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"import": "./dist/cli/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/forge-coding-agent": "^0.84.3",
		"@earendil-works/forge-agent-core": "^0.84.3",
		"@earendil-works/forge-ai": "^0.84.3",
		"chalk": "5.6.2",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"author": "Hiren Dave (https://github.com/hirendave47)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hirendave47/forge.git",
		"directory": "packages/linux-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
