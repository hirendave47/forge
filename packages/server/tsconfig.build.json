{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@earendil-works/forge-ai": ["../ai/dist/index.d.ts"],
			"@earendil-works/forge-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@earendil-works/forge-protocol": ["../protocol/dist/index.d.ts"],
			"@earendil-works/forge-protocol/*": ["../protocol/dist/*.d.ts"],
			"@earendil-works/pi-ai": ["../ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@earendil-works/pi-protocol": ["../protocol/dist/index.d.ts"],
			"@earendil-works/pi-protocol/*": ["../protocol/dist/*.d.ts"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts", "src/**/*.d.ts"]
}
